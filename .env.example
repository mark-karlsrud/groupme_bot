# GroupMe Bot credentials
GROUPME_BOT_ID=your_bot_id_here
GROUPME_ACCESS_TOKEN=your_access_token_here  # from dev.groupme.com, needed for image uploads

# Reddit API credentials — create an app at reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=groupme_bot/1.0 by u/your_username

# Comma-separated list of subreddits to search
SUBREDDITS=gifs,funny,videos,aww,pics

# The trigger prefix (case-insensitive, matches anywhere in message)
BOT_TRIGGER=@bot

# Set to true to include NSFW posts in search results (default: false)
NSFW=false

PORT=5000
